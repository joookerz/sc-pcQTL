singularity.enabled = true
singularity.autoMounts = true
singularity.runOptions = ({
    def hostTmp = System.getenv('TMPDIR') ?: '/tmp'
    if (!hostTmp.startsWith('/') || hostTmp.find(/[\s,:]/)) {
        throw new IllegalArgumentException("TMPDIR must be an absolute path without whitespace, commas, or colons for Singularity: ${hostTmp}")
    }
    def hostTmpPath = new File(hostTmp)
    if (!hostTmpPath.isDirectory() || !hostTmpPath.canWrite()) {
        throw new IllegalArgumentException("TMPDIR does not exist or is not writable: ${hostTmp}")
    }
    def tmpOptions = "--env TMPDIR=${hostTmp}"
    if (hostTmp != '/tmp') {
        tmpOptions += " --bind ${hostTmp}:${hostTmp}"
    }
    return "--cleanenv ${tmpOptions} --env R_ENVIRON_USER=/dev/null --env R_PROFILE_USER=/dev/null --env R_LIBS_USER=/opt/scpcqtl-user-library-disabled"
})()
process {
    container = { params.core_container }
    withLabel: process_qtl { container = { params.saige_container } }
}
